# Obligatorio: genere un valor propio, por ejemplo con `openssl rand -hex 32`.
# El servidor no arranca si esta variable no está definida.
JWT_SECRET=
JWT_EXPIRES_IN=8h
PORT=3001

# Orígenes permitidos por CORS, separados por coma (sin espacios extra)
CORS_ORIGIN=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=cuy_system
DB_USER=postgres
DB_PASSWORD=postgres

# Tamaño del pool de conexiones a PostgreSQL
DB_POOL_MAX=100
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONN_TIMEOUT_MS=5000
