{
  "theme": "neutral",
  "themeVariables": {
    "fontSize": "22px",
    "fontFamily": "Arial, Helvetica, sans-serif",
    "primaryColor": "#eef2f7",
    "primaryBorderColor": "#33475b",
    "primaryTextColor": "#111111",
    "lineColor": "#33475b",
    "tertiaryColor": "#ffffff"
  },
  "flowchart": {
    "nodeSpacing": 30,
    "rankSpacing": 38,
    "padding": 8,
    "curve": "basis",
    "useMaxWidth": false
  },
  "class": {
    "padding": 10,
    "useMaxWidth": false
  },
  "themeCSS": ".edgeLabel { background-color: #ffffff; }"
}